---
import { hero } from '@/config.json'
import { SocialList } from './SocialList'
import Highlight from '@/components/Highlight.astro'
---

<div class="pt-20 pb-12 px-4">
  <div class="max-w-[1300px] mx-auto">
    <div class="max-w-[590px]">
      <h1 class="text-3xl text-balance">
        <Highlight class="font-bold">{hero.name}</Highlight>
        <br/>{hero.bio}
      </h1>
      <div class="text-sm text-secondary mt-3">
        {hero.description}
      </div>
      <SocialList className="mt-[60px]" client:load />
    </div>
    
    <div class="mt-6 text-xs text-center text-balance text-secondary">
      {Array.isArray(hero.yiyan) ? hero.yiyan[0] : hero.yiyan}
    </div>
  </div>
</div>